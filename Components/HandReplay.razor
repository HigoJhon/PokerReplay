@using Replay.Models
@using Replay.Data
@implements IDisposable

<div class="hand-header">
    <h3>Mão @Hand.HandIndexInFile — @Hand.LearningTheme</h3>
    <p class="summary">@Hand.CoachSummary</p>
</div>

<div class="replay-layout">
    <div class="table-column">
        <div class="street-tracker">
            @foreach (var street in streets)
            {
                <span class="street-pill @(street == state.CurrentStreet ? "active" : "")">@street</span>
            }
        </div>

        <div class="poker-table">
            <div class="table-felt">
                <div class="pot-display">
                    Pote: @state.Pot (@ReplayEngine.FormatBB(state.Pot, Hand.Level.BigBlind))
                </div>
                <div class="board">
                    @if (state.Board.Count == 0)
                    {
                        <span class="board-placeholder">—</span>
                    }
                    @foreach (var card in state.Board)
                    {
                        <span class="card @SuitClass(card.Suit)">@CardText(card)</span>
                    }
                </div>
                <div class="game-type">NL Hold'em</div>
            </div>

            @{ var ordered = OrderedSeats; }
            @for (var i = 0; i < ordered.Count; i++)
            {
                var seat = ordered[i];
                var folded = state.FoldedPlayers.Contains(seat.PlayerName);
                var acting = state.CurrentEvent?.PlayerName == seat.PlayerName
                             && state.CurrentEvent?.EventType == "PlayerAction";
                var isDealer = seat.SeatNumber == Hand.InitialTableState.ButtonSeat;
                var seatStyle = GetSeatStyle(i, ordered.Count);
                var betAmount = state.StreetBets.GetValueOrDefault(seat.PlayerName);
                var posLabel = positions.GetValueOrDefault(seat.PlayerName, "");
                var displayName = state.LastAction.TryGetValue(seat.PlayerName, out var actionLabel)
                    ? actionLabel
                    : seat.PlayerName;

                <div class="seat-pos" style="@seatStyle">
                    <div class="hole-slot">
                        @if (!folded)
                        {
                            @if (seat.IsHero && state.HeroCards is not null)
                            {
                                <div class="hole-cards hero-hole">
                                    @foreach (var c in state.HeroCards)
                                    {
                                        <span class="card @SuitClass(c.Suit)">@CardText(c)</span>
                                    }
                                </div>
                            }
                            else if (!seat.IsHero && state.ShowdownCards.TryGetValue(seat.PlayerName, out var villainCards))
                            {
                                <div class="hole-cards">
                                    @foreach (var c in villainCards)
                                    {
                                        <span class="card @SuitClass(c.Suit)">@CardText(c)</span>
                                    }
                                </div>
                            }
                            else if (state.HoleCardsDealt)
                            {
                                <div class="hole-cards">
                                    <span class="card-back"></span>
                                    <span class="card-back"></span>
                                </div>
                            }
                        }
                    </div>

                    <div class="seat-row">
                        <div class="seat-avatar @PositionClass(posLabel) @(folded ? "folded" : "") @(acting ? "acting" : "")">
                            @posLabel
                            @if (isDealer)
                            {
                                <span class="dealer-badge">D</span>
                            }
                        </div>
                        <div class="seat-info @(folded ? "folded" : "")">
                            <div class="seat-name">@displayName</div>
                            <div class="seat-stack">
                                @state.Stacks.GetValueOrDefault(seat.PlayerName)
                                (@ReplayEngine.FormatBB(state.Stacks.GetValueOrDefault(seat.PlayerName), Hand.Level.BigBlind))
                            </div>
                        </div>
                    </div>
                </div>
            }

            @for (var i = 0; i < ordered.Count; i++)
            {
                var seat = ordered[i];
                var betAmount = state.StreetBets.GetValueOrDefault(seat.PlayerName);
                if (betAmount <= 0) { continue; }
                var chipStyle = GetChipStyle(i, ordered.Count);

                <div class="bet-chip" style="@chipStyle">
                    @betAmount (@ReplayEngine.FormatBB(betAmount, Hand.Level.BigBlind))
                </div>
            }
        </div>

        @if (state.PotsAwarded.Count > 0)
        {
            <div class="winner-box">
                @foreach (var result in state.PotsAwarded)
                {
                    <div>🏆 @result.PlayerName ganha @result.Amount (@ReplayEngine.FormatBB(result.Amount, Hand.Level.BigBlind))</div>
                }
            </div>
        }

        <div class="controls">
            <button @onclick="Prev" disabled="@(stepIndex <= 0)">◀ Anterior</button>
            <button @onclick="TogglePlay">@(isPlaying ? "⏸ Pausar" : "▶ Auto-play")</button>
            <span>Evento @(stepIndex + 1) / @totalEvents</span>
            <button @onclick="Next" disabled="@(stepIndex >= totalEvents - 1)">Próximo ▶</button>
        </div>

        <details class="history-collapsed">
            <summary>Histórico da mão</summary>
            <div class="action-log">
                @foreach (var line in state.ActionLog)
                {
                    <div>@line</div>
                }
            </div>
        </details>
    </div>

    <div class="coach-sidebar">
        <h4>🧠 Análise da IA</h4>
    
        @if (state.CurrentEvent?.HeroAnalysis is { } analysis)
        {
            <div class="coach-box eval-@analysis.Evaluation.ToLower()">
                <div class="eval-tag">@analysis.Evaluation</div>
                <p>@analysis.Commentary</p>
    
                @if (!string.IsNullOrEmpty(analysis.SuggestedAction))
                {
                    <div class="suggestion">
                        Sugestão: <strong>@analysis.SuggestedAction</strong>
                        @(analysis.SuggestedAmount > 0
                            ? $" ({ReplayEngine.FormatBB((int)analysis.SuggestedAmount, Hand.Level.BigBlind)})"
                            : "")
                    </div>
                }
    
                @if (analysis.DecisionFactors is { Count: > 0 })
                {
                    <div class="factors">
                        @foreach (var factor in analysis.DecisionFactors)
                        {
                            <span class="factor-chip">@factor</span>
                        }
                    </div>
                }
    
                @if (!string.IsNullOrEmpty(analysis.CoachingPoint))
                {
                    <div class="coaching-point">💡 @analysis.CoachingPoint</div>
                }
            </div>
        }
        else if (state.CurrentEvent?.OpponentAnalysis is { } oppAnalysis)
        {
            <div class="coach-box opponent-box">
                <div class="eval-tag opponent-tag">
                    Leitura do vilão @(!string.IsNullOrEmpty(oppAnalysis.PressureLevel) ? $"· Pressão {oppAnalysis.PressureLevel}" : "")
                </div>
                <p>@oppAnalysis.Commentary</p>
    
                @if (!string.IsNullOrEmpty(oppAnalysis.RangeAssessment))
                {
                    <div class="range-row">
                        Range: <span class="range-badge range-@oppAnalysis.RangeAssessment.ToLower()">@oppAnalysis.RangeAssessment</span>
                    </div>
                }
    
                @if (!string.IsNullOrEmpty(oppAnalysis.RangeNote))
                {
                    <p class="range-note">@oppAnalysis.RangeNote</p>
                }
    
                @if (!string.IsNullOrEmpty(oppAnalysis.ExploitAdjustment))
                {
                    <div class="exploit-note">🎯 @oppAnalysis.ExploitAdjustment</div>
                }
            </div>
        }
        else
        {
            <p class="no-analysis">Nenhuma decisão-chave neste momento da mão.</p>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public NotableHand Hand { get; set; } = default!;

    private readonly string[] streets = { "Preflop", "Flop", "Turn", "River" };

    private int stepIndex;
    private int totalEvents;
    private ReplayState state = new();
    private Dictionary<string, string> positions = new();

    private bool isPlaying;
    private System.Threading.Timer? autoPlayTimer;

    protected override void OnParametersSet()
    {
        totalEvents = Hand.TimelineEvents.Count;
        stepIndex = 0;
        positions = ReplayEngine.CalculatePositions(Hand);
        StopAutoPlay();
        Recompute();
    }

    private void Next()
    {
        if (stepIndex < totalEvents - 1)
        {
            stepIndex++;
            Recompute();
        }
        else
        {
            StopAutoPlay();
        }
    }

    private void Prev() { if (stepIndex > 0) { stepIndex--; Recompute(); } }
    private void Recompute() => state = ReplayEngine.BuildState(Hand, stepIndex);

    private void TogglePlay()
    {
        if (isPlaying) { StopAutoPlay(); return; }

        isPlaying = true;
        autoPlayTimer = new System.Threading.Timer(_ =>
        {
            InvokeAsync(() => { Next(); StateHasChanged(); });
        }, null, 1500, 1500);
    }

    private void StopAutoPlay()
    {
        isPlaying = false;
        autoPlayTimer?.Dispose();
        autoPlayTimer = null;
    }

    public void Dispose() => autoPlayTimer?.Dispose();

    private List<SeatInfo> OrderedSeats
    {
        get
        {
            var seats = Hand.InitialTableState.Seats;
            var heroIndex = seats.FindIndex(s => s.IsHero);
            if (heroIndex < 0) return seats;
            return seats.Skip(heroIndex).Concat(seats.Take(heroIndex)).ToList();
        }
    }

    private static string GetSeatStyle(int indexFromHero, int total)
    {
        var (left, top) = PointOnEllipse(indexFromHero, total, 42, 44);
        return $"left:{Fmt(left)}%; top:{Fmt(top)}%;";
    }

    // ponto mais próximo do centro, na mesma direção do assento — aposta sempre "aponta pra dentro" da mesa
    private static string GetChipStyle(int indexFromHero, int total)
    {
        var (left, top) = PointOnEllipse(indexFromHero, total, 26, 27);
        return $"left:{Fmt(left)}%; top:{Fmt(top)}%;";
    }

    private static (double left, double top) PointOnEllipse(int indexFromHero, int total, double rx, double ry)
    {
        double angleDeg = 90 + (360.0 / total) * indexFromHero;
        double angleRad = angleDeg * Math.PI / 180;
        double left = 50 + rx * Math.Cos(angleRad);
        double top = 50 + ry * Math.Sin(angleRad);
        return (left, top);
    }

    private static string Fmt(double v) => v.ToString(System.Globalization.CultureInfo.InvariantCulture);

    private static string CardText(Card c) => $"{c.Rank}{Naipe(c.Suit)}";
    private static string Naipe(string s) => s switch
    {
        "h" => "♥", "d" => "♦", "c" => "♣", "s" => "♠", _ => s
    };
    private static string SuitClass(string s) => (s == "h" || s == "d") ? "red" : "black";

    private static string PositionClass(string pos) => pos switch
    {
        _ when pos.StartsWith("BTN") => "pos-btn",
        "SB" => "pos-sb",
        "BB" => "pos-bb",
        "CO" => "pos-co",
        "HJ" => "pos-hj",
        _ when pos.StartsWith("UTG") => "pos-utg",
        _ => "pos-other"
    };
}