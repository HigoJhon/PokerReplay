@page "/"
@rendermode InteractiveServer
@using Replay.Data
@using Replay.Models
@inject HandHistoryLoader Loader

<h1>Poker Replay</h1>

@if (dados is null)
{
    <p>Carregando...</p>
}
else
{
    <select @onchange="OnHandChanged">
        @foreach (var hand in dados.NotableHands)
        {
            <option value="@hand.HandIndexInFile">Mão @hand.HandIndexInFile — @hand.LearningTheme</option>
        }
    </select>

    @if (selectedHand is not null)
    {
        <HandReplay Hand="selectedHand" />
    }
}

@code {
    private HandHistoryFile? dados;
    private NotableHand? selectedHand;

    protected override async Task OnInitializedAsync()
    {
        dados = await Loader.LoadAsync();
        selectedHand = dados?.NotableHands.FirstOrDefault();
    }

    private void OnHandChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var idx))
            selectedHand = dados?.NotableHands.FirstOrDefault(h => h.HandIndexInFile == idx);
    }
}